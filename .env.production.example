# Pathfinder AI - Production Environment Template
# Replace these values with your production deployment secrets

# Convex Production Deployment URL
NEXT_PUBLIC_CONVEX_URL=https://oceanic-leopard-50.convex.cloud
CONVEX_DEPLOYMENT=prod:oceanic-leopard-50

# Web Hosting Public URL (e.g. https://yourdomain.com or https://your-project.vercel.app)
NEXT_PUBLIC_HOSTING_URL=https://your-production-domain.com
HOSTING_URL=https://your-production-domain.com

# Clerk Authentication (Production Instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk Auth Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Gemini AI Provider
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key

# Third-party Integrations (Optional)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
OPEN_WEATHER_MAP_API_KEY=your_open_weather_map_key
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Pathfinder AI <onboarding@resend.dev>
