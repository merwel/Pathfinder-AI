# ==============================================================================
# VOYAGEAI - ENVIRONMENT CONFIGURATION (.env.sample)
# Copy this file to .env.local for local frontend Next.js development.
# ==============================================================================
# IMPORTANT:
# - Variables starting with NEXT_PUBLIC_ are exposed to the browser.
# - Variables used inside Convex functions (convex/*.ts) MUST also be configured
#   in the Convex Dashboard (or via `npx convex env set KEY=VALUE`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONVEX CONFIGURATION
# Where to get: Run `npx convex dev` to initialize your project, or check
# https://dashboard.convex.dev under Settings > Deployment URL.
# ------------------------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ------------------------------------------------------------------------------
# 2. APPLICATION HOSTING URL
# Where to get: http://localhost:3000 during local dev, or your production domain
# (e.g., https://voyage-ai.vercel.app).
# NOTE: Set HOSTING_URL in the Convex Dashboard for background invite email links.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HOSTING_URL=http://localhost:3000
HOSTING_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION
# Where to get: https://dashboard.clerk.com -> Select Application -> API Keys.
# For CLERK_JWT_ISSUER_DOMAIN: In Clerk Dashboard -> JWT Templates -> Create "convex" template ->
# copy the Issuer URL (e.g. "https://prompt-pelican-42.clerk.accounts.dev").
# Set CLERK_JWT_ISSUER_DOMAIN in the Convex Dashboard for backend token verification.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer-domain.clerk.accounts.dev

# Clerk Webhook Secret (Set in Convex Dashboard)
# Where to get: Clerk Dashboard -> Webhooks -> Add endpoint ->
# URL: https://<your-convex-deployment>.convex.site/clerk-users-webhook
# Subscribe to: user.created, user.updated, user.deleted. Copy the Signing Secret (whsec_...).
CLERK_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 4. AI GENERATION (Gemini & OpenAI)
# Must be configured in the Convex Dashboard as Convex backend actions run server-side.
# Where to get Gemini key: https://aistudio.google.com/app/apikey
# Where to get OpenAI key: https://platform.openai.com/api-keys
# AI_PROVIDER: gemini (default) or openai
# GEMINI_MODEL: gemini-3.8-flash (recommended) or gemini-flash-latest
# OPENAI_MODEL: gpt-4o-mini (recommended) or gpt-4o
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. UNSPLASH API (Destination Photography)
# Must be configured in Convex Dashboard (downloaded once and stored in Convex storage).
# Where to get: https://unsplash.com/developers -> Create App -> Access Key
# ------------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS JAVASCRIPT API & PLACES
# Where to get: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable: "Maps JavaScript API" and "Places API"
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 7. OPENWEATHERMAP API (Weather Forecast)
# Must be configured in Convex Dashboard.
# Where to get: https://openweathermap.org/api -> Free Current Weather API key
# ------------------------------------------------------------------------------
OPEN_WEATHER_MAP_API_KEY=your_openweathermap_api_key

# ------------------------------------------------------------------------------
# 8. RESEND (Collaborator Invite Emails)
# Must be configured in Convex Dashboard (calls Resend in Convex Node Action).
# Where to get: https://resend.com/api-keys
# RESEND_FROM_EMAIL: e.g. "VoyageAI <invites@yourdomain.com>" or "onboarding@resend.dev"
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 9. STRIPE PAYMENTS (Optional - Credits pack checkout)
# If omitted, credit purchases and pricing tables gracefully disable.
# Must be set in Convex Dashboard.
# Where to get: https://dashboard.stripe.com/test/apikeys
# Webhook URL: https://<your-convex-deployment>.convex.site/stripe
# Events: checkout.session.completed
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
